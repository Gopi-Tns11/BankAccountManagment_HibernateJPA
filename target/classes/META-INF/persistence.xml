<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    version="3.1">

    <persistence-unit
        name="BankPU"
        transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <class>com.bank.entity.Customer</class>
        <class>com.bank.entity.Account</class>

        <properties>

            <!-- SQL Server Driver -->
            <property
                name="jakarta.persistence.jdbc.driver"
                value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>

            <!-- Database URL -->
     
             <property
                name="jakarta.persistence.jdbc.url"
                value="jdbc:sqlserver://TNS-IT-DESKTOP;instanceName=SQLEXPRESS;databaseName=TrainingJul2026;encrypt=true;trustServerCertificate=true;integratedSecurity=true"/>
           
             <!-- Username -->
            <property
                name="jakarta.persistence.jdbc.user"
                value="YOUR_USERNAME"/>

            <!-- Password -->
            <property
                name="jakarta.persistence.jdbc.password"
                value="YOUR_PASSWORD"/>

            <!-- Hibernate SQL Server dialect -->
            <property
                name="hibernate.dialect"
                value="org.hibernate.dialect.SQLServerDialect"/>

            <!-- Display SQL -->
            <property
                name="hibernate.show_sql"
                value="true"/>

            <!-- Format SQL -->
            <property
                name="hibernate.format_sql"
                value="true"/>

            <!-- Automatically update schema -->
            <property
                name="hibernate.hbm2ddl.auto"
                value="update"/>

        </properties>

    </persistence-unit>

</persistence>